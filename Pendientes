Sub ActualizarPendientes()

    Const WB_ACUMULADO As String = "Acumulado sat 2026"
    Const HOJA_ACUMULADO As String = "Acumulado sat 2026"

    Const COL_BUSCAR As Long = 4      ' D
    Const COL_E As Long = 5           ' Complemento
    Const COL_F As Long = 6           ' No aplica / Pendiente
    Const COL_G As Long = 7           ' Monto
    Const COL_H As Long = 8           ' Validacion
    Const COL_U As Long = 21          ' U

    Const COL_ORIGEN_BR As Long = 70
    Const COL_ORIGEN_BS As Long = 71

    Const MIN_CHARS As Long = 30
    Const MAX_CHARS As Long = 40

    Dim wbAcum As Workbook
    Dim wsPago As Worksheet
    Dim wsAcum As Worksheet
    Dim dictAcum As Object

    Dim filaActual As Long
    Dim ultimaFila As Long
    Dim ultimaAcum As Long
    Dim filaAcum As Long

    Dim clave As String
    Dim valorBR As Variant
    Dim valorBS As Variant
    Dim textoBR As String

    Set wsPago = ThisWorkbook.ActiveSheet

    Dim wb As Workbook

    For Each wb In Application.Workbooks
        If InStr(1, wb.Name, WB_ACUMULADO, vbTextCompare) > 0 Then
            Set wbAcum = wb
            Exit For
        End If
    Next wb

    If wbAcum Is Nothing Then
        MsgBox "No se encontro el archivo Acumulado.", vbExclamation
        Exit Sub
    End If

    Set wsAcum = wbAcum.Sheets(HOJA_ACUMULADO)

    Set dictAcum = CreateObject("Scripting.Dictionary")
    dictAcum.CompareMode = vbTextCompare

    ultimaAcum = wsAcum.Cells(wsAcum.Rows.Count, 1).End(xlUp).Row

    Dim r As Long

    For r = 2 To ultimaAcum

        If Trim(wsAcum.Cells(r, 1).Value) <> "" Then

            If Not dictAcum.Exists(Trim(wsAcum.Cells(r, 1).Value)) Then
                dictAcum.Add Trim(wsAcum.Cells(r, 1).Value), r
            End If

        End If

    Next r

    ultimaFila = wsPago.Cells(wsPago.Rows.Count, COL_BUSCAR).End(xlUp).Row

    Application.ScreenUpdating = False

    Dim actualizados As Long
    actualizados = 0

    For filaActual = 3 To ultimaFila

        If InStr(UCase(wsPago.Cells(filaActual, COL_F).Value), "PENDIENTE") = 0 Then
            GoTo SiguienteFila
        End If

        clave = Trim(CStr(wsPago.Cells(filaActual, COL_BUSCAR).Value))

        If clave = "" Then GoTo SiguienteFila

        If Not dictAcum.Exists(clave) Then GoTo SiguienteFila

        filaAcum = dictAcum(clave)

        valorBR = wsAcum.Cells(filaAcum, COL_ORIGEN_BR).Value

        If IsError(valorBR) Then valorBR = ""

        textoBR = UCase(Trim(CStr(valorBR)))

        If textoBR = "" Then GoTo SiguienteFila

        If InStr(textoBR, "PENDIENTE") > 0 Then
            GoTo SiguienteFila
        End If
        wsPago.Cells(filaActual, COL_E).ClearContents
        wsPago.Cells(filaActual, COL_F).ClearContents
        wsPago.Cells(filaActual, COL_G).ClearContents
        wsPago.Cells(filaActual, COL_H).ClearContents

        If InStr(textoBR, "NO APLICA") > 0 Then

            wsPago.Cells(filaActual, COL_F).Value = valorBR

        ElseIf Len(Trim(CStr(valorBR))) >= MIN_CHARS _
           And Len(Trim(CStr(valorBR))) <= MAX_CHARS Then

            wsPago.Cells(filaActual, COL_E).Value = valorBR

            valorBS = wsAcum.Cells(filaAcum, COL_ORIGEN_BS).Value

            If Trim(valorBS & "") <> "" Then

                wsPago.Cells(filaActual, COL_G).Value = valorBS

                wsPago.Cells(filaActual, COL_H).FormulaLocal = _
                    "=G" & filaActual & "+U" & filaActual

            End If

        Else

            wsPago.Cells(filaActual, COL_F).Value = valorBR

        End If

        actualizados = actualizados + 1

SiguienteFila:

    Next filaActual

    Application.ScreenUpdating = True

    MsgBox "Pendientes actualizados: " & actualizados, vbInformation

End Sub
