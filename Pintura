Sub PegarNotasAduanales()

    Dim wsAcum As Worksheet
    Dim wsNotas As Worksheet
    Dim ultimaFila As Long
    Dim i As Long
    Dim j As Integer
    Dim folio As String
    Dim filaDestino As Long

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False

    Set wsAcum = Me.Parent.Sheets("ACUMULADO SAT 2026")
    Set wsNotas = Me.Parent.Sheets("NOTAS")

    Const colA  As Integer = 1
    Const colBG As Integer = 59
    Const colBS As Integer = 71

    Dim colorAmarillo As Long
    Dim colorRosaPastel As Long
    colorAmarillo   = RGB(255, 255, 0)
    colorRosaPastel = RGB(255, 182, 193)

    ultimaFila = wsAcum.Cells(wsAcum.Rows.Count, colA).End(xlUp).Row

    ' --- PASO 1: Filtrar BG = "agentes aduanales" ---
    wsAcum.AutoFilterMode = False
    wsAcum.Range("A1").AutoFilter Field:=colBG, Criteria1:="agentes aduanales"

    ' --- PASO 2: Filas visibles amarillas → guardar folio de BS ---
    Dim listaFolios As Collection
    Set listaFolios = New Collection

    Dim rngVisible As Range
    Dim celda As Range

    On Error Resume Next
    Set rngVisible = wsAcum.Range(wsAcum.Cells(2, colA), _
                     wsAcum.Cells(ultimaFila, colA)).SpecialCells(xlCellTypeVisible)
    On Error GoTo 0

    If Not rngVisible Is Nothing Then
        For Each celda In rngVisible
            If celda.Interior.Color = colorAmarillo Then
                folio = Trim(CStr(wsAcum.Cells(celda.Row, colBS).Value))
                If Len(folio) >= 30 And Len(folio) <= 40 Then
                    listaFolios.Add folio
                End If
            End If
        Next celda
    End If

    ' --- PASO 3: Quitar filtros ---
    wsAcum.AutoFilterMode = False

    ' --- PASO 4: Leer NOTAS fila 14 columnas B:F ---
    Dim arrNotas(1 To 5) As Variant
    For j = 1 To 5
        arrNotas(j) = wsNotas.Cells(14, j + 1).Value
    Next j

    ' --- PASO 5: Diccionario con columna A para búsqueda rápida ---
    Dim arrA() As Variant
    arrA = wsAcum.Range(wsAcum.Cells(2, colA), wsAcum.Cells(ultimaFila, colA)).Value

    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")
    dict.CompareMode = 1
    Dim k As Long
    For k = 1 To UBound(arrA, 1)
        Dim clave As String
        clave = Trim(CStr(arrA(k, 1)))
        If clave <> "" And Not dict.Exists(clave) Then
            dict.Add clave, k + 1
        End If
    Next k

    ' --- PASO 6: Buscar cada folio en A y pegar ---
    Dim procesadas As Long
    procesadas = 0

    For i = 1 To listaFolios.Count

        folio = listaFolios(i)

        If dict.Exists(folio) Then

            filaDestino = dict(folio)

            Dim rngDest As Range
            Set rngDest = wsAcum.Range( _
                wsAcum.Cells(filaDestino, colBG), _
                wsAcum.Cells(filaDestino, colBG + 4))

            For j = 1 To 5
                rngDest.Cells(1, j).Value = arrNotas(j)
            Next j

            rngDest.Interior.Color = colorRosaPastel
            procesadas = procesadas + 1

        End If

        Application.StatusBar = "Pegando " & i & " de " & listaFolios.Count & _
                                "  |  Completadas: " & procesadas
    Next i

    ' --- Restaurar ---
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    Application.StatusBar = False

    MsgBox "¡Terminado! Se procesaron " & procesadas & " coincidencias.", vbInformation

End Sub
